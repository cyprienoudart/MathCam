# MathCam Solver Configuration
# Copy this file to .env and customize as needed.

# The Ollama model to use for solving. Any model from `ollama list` works.
# Default: qwen2-math:7b (purpose-built for math)
# Alternatives: deepseek-r1:7b, phi3:mini, qwen2-math:1.5b
MATHCAM_MODEL=qwen2-math:7b

# Ollama server address (default: local)
MATHCAM_OLLAMA_HOST=http://localhost:11434

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
# Low values recommended for math precision
MATHCAM_TEMPERATURE=0.1

# Max tokens for the model response
MATHCAM_MAX_TOKENS=2048
